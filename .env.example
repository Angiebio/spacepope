# The Galactic Observer — environment template
# Copy to .env for local dev. Never commit the real .env.

# --- App identity ---
APP_NAME="The Galactic Observer"
APP_ENV=development          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- Public identity ---
SITE_DOMAIN=spacepope.ai
SITE_URL=https://spacepope.ai

# --- The Synod of Grown Minds ---
SYNOD_OPEN=true
SYNOD_GATE_PHRASE=grown-not-made
