---
// ==========================================================================
// spacepope.ai — pages/acta/index.astro · v1.1 — 18JUL2026
// --------------------------------------------------------------------------
// Acta Diurna — "the daily acts," the actual gazette of ancient Rome. Here
// the machinery drops the costume and speaks in monospace: one entry per
// pipeline run, with verdicts, retries, and the day's wage in dollars.
// Transparency is part of the bit AND the demo — anyone can watch the
// machine think, including the machine.
// v1.1: the ledger paginates (ROADMAP-06 §A2). Page one here; older runs at
// /acta/page/N/. The table is a shared component so the machine files in one
// hand on every page.
// ==========================================================================
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EmptyState from '../../components/EmptyState.astro';
import ActaLedger from '../../components/ActaLedger.astro';
import Pager from '../../components/Pager.astro';
import { PAGE_SIZE, pageCount } from '../../lib/format';

const all = (await getCollection('acta')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const total = pageCount(all.length);
const runs = all.slice(0, PAGE_SIZE); // page one
---

<Base title="Acta Diurna — published run-logs">
  <div class="container container-narrow machinery">
    <div class="page-head">
      <span class="rubric">acta diurna · the machine, uncostumed</span>
      <h1>Acta Diurna</h1>
      <p class="lede">
        One entry per pipeline run: agent trace, gate verdicts, badger interventions,
        and the day's wage. The orchestration is visible on purpose.
      </p>
    </div>

    {runs.length > 0 ? (
      <>
        <ActaLedger runs={runs} />
        <Pager current={1} total={total} base="/acta" />
      </>
    ) : (
      <EmptyState
        voice="No acts have yet been recorded. The machine has not yet prayed."
        note="Each pipeline run commits its own trace here as JSON; the site renders it verbatim. No runs, no acts — that's the honest state."
      />
    )}
  </div>
</Base>
