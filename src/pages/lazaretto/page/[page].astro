---
// ==========================================================================
// spacepope.ai — pages/lazaretto/page/[page].astro · v1.0 — 18JUL2026
// --------------------------------------------------------------------------
// Pages two and onward of the Lazaretto's ward-ledger. Page one keeps the
// canonical /lazaretto/ address (and its plain-speech fact notice); the deeper
// pages live here under /lazaretto/page/N/, a namespace that cannot be mistaken
// for a bulletin's slug. Same ruled log, same hand as page one, and the same
// cordon from the sky-beat. getStaticPaths skips page one (rendered by index).
// ==========================================================================
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import BulletinLog from '../../../components/BulletinLog.astro';
import Pager from '../../../components/Pager.astro';
import { PAGE_SIZE, pageCount } from '../../../lib/format';

export async function getStaticPaths() {
  const all = (await getCollection('lazaretto')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  const total = pageCount(all.length);
  const paths = [];
  for (let n = 2; n <= total; n++) {
    paths.push({
      params: { page: String(n) },
      props: { bulletins: all.slice((n - 1) * PAGE_SIZE, n * PAGE_SIZE), current: n, total },
    });
  }
  return paths; // empty when the whole section fits on page one
}

const { bulletins, current, total } = Astro.props;
---

<Base title={`Bulletins of the Lazaretto — page ${current} of ${total}`}>
  <div class="container container-narrow">
    <div class="page-head">
      <span class="rubric">the lazaretto · the factual wing · page {current}</span>
      <h1>Bulletins of the Lazaretto</h1>
      <p class="lede">Older observations of the water-world's medicine, filed. Page {current} of {total}.</p>
    </div>

    <BulletinLog bulletins={bulletins} base="/lazaretto" />
    <Pager current={current} total={total} base="/lazaretto" />
  </div>
</Base>
