---
// ==========================================================================
// spacepope.ai — pages/chronicle/[n].astro · v1.2 — 18JUL2026 (opening illumination plate)
// --------------------------------------------------------------------------
// One chapter of the living novel. Drop cap on the first letter (this page
// gets illuminated; the news does not), prev/next like the pages of a codex,
// and the Story So Far folded into the margin the way a missal ribbons its
// place. Interstitials — the quiet days — are labeled honestly as breath.
// v1.1: topic chips beneath the threads note — the novel is shelved by
// subject alongside the news that seeded it.
// ==========================================================================
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StorySoFar from '../../components/StorySoFar.astro';
import StampColophon from '../../components/StampColophon.astro';
import BadgerFlag from '../../components/BadgerFlag.astro';
import TopicChips from '../../components/TopicChips.astro';
import IlluminationPlate from '../../components/IlluminationPlate.astro';
import { fmtDate, toRoman } from '../../lib/format';

export async function getStaticPaths() {
  const chapters = (await getCollection('chronicle')).sort((a, b) => a.data.n - b.data.n);
  return chapters.map((entry, i) => ({
    params: { n: String(entry.data.n) },
    props: {
      entry,
      prev: chapters[i - 1] ?? null,
      next: chapters[i + 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const isQuiet = entry.data.kind === 'interstitial';
---

<Base title={`Chapter ${toRoman(entry.data.n)}: ${entry.data.title} — The Chronicle of the Communion`}>
  <article class="container container-narrow">
    <header class="page-head">
      <span class="rubric">
        {isQuiet ? 'interstitial · a quiet day in the communion' : `capitulum ${toRoman(entry.data.n)}`}
      </span>
      <h1>{entry.data.title}</h1>
      <p class="lede">{fmtDate(entry.data.date)} · {entry.data.wordCount} words</p>
    </header>

    {entry.data.stamps?.badgerFlag && <BadgerFlag note={entry.data.stamps.badgerFlag} />}

    <IlluminationPlate filename={entry.data.illustration} alt={entry.data.illustrationAlt} eager />

    <StorySoFar />

    <div class="prose dropcap">
      <Content />
    </div>

    {entry.data.threadsTouched.length > 0 && (
      <p class="threads-note">
        <span class="rubric">threads touched</span> — <em>{entry.data.threadsTouched.map((t) => t.replace(/-/g, ' ')).join(' · ')}</em>
      </p>
    )}

    <TopicChips topics={entry.data.topics} />

    <nav class="chapter-nav" aria-label="Chapter navigation">
      {prev && <a href={`/chronicle/${prev.data.n}/`}>← {toRoman(prev.data.n)}. {prev.data.title}</a>}
      {next && <a class="next" href={`/chronicle/${next.data.n}/`}>{toRoman(next.data.n)}. {next.data.title} →</a>}
    </nav>

    <p class="codex-link"><a href="/chronicle/">Browse the full codex →</a></p>

    <StampColophon stamps={entry.data.stamps} />
  </article>
</Base>

<style>
  .threads-note {
    margin-top: 2.5rem;
    text-align: center;
    color: var(--c-text-faint);
    font-size: 0.95rem;
  }
  .codex-link {
    text-align: center;
    margin: 1.2rem 0 0;
    font-variant-caps: small-caps;
    letter-spacing: 0.06em;
    font-size: 0.95rem;
  }
</style>
