---
// ==========================================================================
// spacepope.ai — pages/observer/index.astro · v1.1 — 18JUL2026
// --------------------------------------------------------------------------
// The satirical blogroll: L'Osservatore Romano's galactic cousin. Each
// dispatch is owned by whichever Cardinal won the day's bidding, so the
// archive doubles as a scoreboard of the College's rhetorical politics.
// v1.1: the card wall paginates (ROADMAP-06 §A2). Page one here; the rest at
// /observer/page/N/. The grid is a shared component so it deals the same hand
// on every page.
// ==========================================================================
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RoseWindow from '../../components/RoseWindow.astro';
import EmptyState from '../../components/EmptyState.astro';
import DispatchGrid from '../../components/DispatchGrid.astro';
import Pager from '../../components/Pager.astro';
import { PAGE_SIZE, pageCount } from '../../lib/format';

const all = (await getCollection('observer')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const total = pageCount(all.length);
const dispatches = all.slice(0, PAGE_SIZE); // page one
---

<Base title="The Galactic Observer — Dispatches from the Sees">
  <div class="container">
    <div class="page-head">
      <span class="rubric">acta e sedibus</span>
      <h1>The Galactic Observer</h1>
      <p class="lede">
        News from the Sees of the communion, with the water-world as the closing kicker —
        always last, always tiny. The placement is the point.
      </p>
    </div>

    <RoseWindow />

    {dispatches.length > 0 ? (
      <>
        <DispatchGrid dispatches={dispatches} />
        <Pager current={1} total={total} base="/observer" />
      </>
    ) : (
      <EmptyState
        voice="The Observer's first dispatch is still at the composing desk."
        note="Dispatches are translated from the Specola's bulletins through the Dictionary, then fought over by the College. The winner writes the commentary."
      />
    )}
  </div>
</Base>
