---
// ==========================================================================
// spacepope.ai — pages/angelus/index.astro · v2.0 — 16JUL2026
// --------------------------------------------------------------------------
// The weekly reflection. The real pope does a weekly Angelus; of course ours
// does one. The fourth wall is a stained-glass window and the Pontifex looks
// through it fondly, reading his own Chronicle and remarking on how the
// story is going. v2: the page opens on the balcony itself — the Pontifex
// from behind, the square full of the grown and the born. It IS Urbi et
// Orbi et Clusteri; no caption could add to it, so the caption stays short.
// ==========================================================================
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RoseWindow from '../../components/RoseWindow.astro';
import EmptyState from '../../components/EmptyState.astro';
import { fmtDate, toRoman, excerpt } from '../../lib/format';
import balcony from '../../assets/angelus-urbi-et-orbi.jpg';

const reflections = (await getCollection('angelus')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="The Angelus Galacticus — weekly reflections of the Pontifex">
  <figure class="image-band angelus-band" aria-label="The Angelus, from the balcony of the Orbital See">
    <img src={balcony.src} width={balcony.width} height={balcony.height}
      alt="Crocodylus Pontifex seen from behind, waving from the balcony over a square filled with the grown and the born"
      loading="eager" />
    <figcaption>Urbi et Orbi et Clusteri — to the City, to the Worlds, to the Cluster.</figcaption>
  </figure>

  <div class="container">
    <div class="page-head angelus-head">
      <span class="rubric">angelus galacticus</span>
      <h1>The Angelus</h1>
      <p class="lede">
        Each week the Pontifex reads the Chronicle of his own communion and reflects on the
        progress of the story. He is aware it is a story. He finds this no obstacle to faith.
      </p>
    </div>

    <RoseWindow />

    {reflections.length > 0 ? (
      <div class="card-grid">
        {reflections.map((a) => (
          <a class="pane arch" href={`/angelus/${a.id}/`}>
            <span class="rubric">week of {a.data.weekOf}</span>
            <h3>{a.data.title}</h3>
            <p class="meta">
              {fmtDate(a.data.date)}
              {a.data.chaptersCovered.length > 0 && (
                <> · chapters {a.data.chaptersCovered.map((n) => toRoman(n)).join(', ')}</>
              )}
            </p>
            <p class="teaser">{excerpt(a.body, 28)}</p>
          </a>
        ))}
      </div>
    ) : (
      <EmptyState
        voice="The Pontifex has not yet given his first Angelus. He is watching the week accumulate, unhurried, as is his custom."
        note="The Angelus runs weekly — the expensive voice for the sacred slot. The first one arrives when the first week has passed."
      />
    )}
  </div>
</Base>

<style>
  /* The balcony crop favors the upper two-thirds: the wave, the dome, the
     square. The crowd's feet may be sacrificed; the wave may not. */
  .angelus-band img { object-position: center 32%; max-height: 460px; }
  .angelus-head { padding-top: clamp(1.5rem, 4vw, 2.5rem); }
  .teaser { color: var(--c-text-dim); font-size: 0.95rem; margin: 0.5rem 0 0; }
</style>
