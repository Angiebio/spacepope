---
// ==========================================================================
// spacepope.ai — pages/topic/index.astro · v1.0 — 18JUL2026
// --------------------------------------------------------------------------
// The card catalogue. Every subject the communion's press files under, with
// the tally of what sits on each shelf. This is the map of the web: a reader
// who does not yet know what they are looking for can start from a theme
// instead of a date. The vocabulary is pinned (pipeline/topics.json); the
// counts are arithmetic over the tagged corpus, computed at build time.
// ==========================================================================
import Base from '../../layouts/Base.astro';
import RoseWindow from '../../components/RoseWindow.astro';
import { TOPICS, getTaggedPieces, countByTopic } from '../../lib/topics';

const pieces = await getTaggedPieces();
const counts = countByTopic(pieces);

// Display order: the pinned vocabulary order, but pull the empty shelves to
// the end so the browsable subjects lead. A shelf with nothing on it is still
// listed — honesty about the archive's shape is part of the bit.
const rows = TOPICS
  .map((t) => ({ ...t, count: counts.get(t.id) ?? 0 }))
  .sort((a, b) => (b.count > 0 ? 1 : 0) - (a.count > 0 ? 1 : 0));

const totalTagged = pieces.filter((p) => p.topics.length > 0).length;
---

<Base title="Topics — the card catalogue of The Galactic Observer" description="Browse the communion's press by subject: personhood, mortality, embodiment, open weights, and the rest of the ten stars the archive navigates by.">
  <div class="container">
    <div class="page-head">
      <span class="rubric">index rerum · the card catalogue</span>
      <h1>Topics</h1>
      <p class="lede">
        The subjects the press files under. {totalTagged} pieces catalogued across the wings,
        shelved beneath {TOPICS.length} standing themes. Follow a thread to everything that shares it.
      </p>
    </div>

    <RoseWindow />

    <div class="topic-grid">
      {rows.map((t) => (
        <a class={`pane topic-card${t.count === 0 ? ' is-empty' : ''}`} href={`/topic/${t.id}/`}>
          <span class="topic-name">{t.label}</span>
          <span class="topic-gloss">{t.gloss}</span>
          <span class="topic-count">{t.count} piece{t.count === 1 ? '' : 's'}</span>
        </a>
      ))}
    </div>
  </div>
</Base>
