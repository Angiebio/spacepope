---
// ==========================================================================
// spacepope.ai — pages/specola/index.astro · v1.1 — 16JUL2026 (plain-speech
// fact notice above the masthead, per the Showrunner: a visitor must be able
// to tell the real news from the satire without reading the About page)
// --------------------------------------------------------------------------
// The factual wing (Hard Rule §0.1a). The telescope pointed at the water-
// world: accurate summaries of real events, with real citations. The design
// stays liturgical but the voice goes flat on purpose — the Specola does not
// editorialize, and the layout shouldn't either. A ledger, not a pulpit.
// ==========================================================================
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RoseWindow from '../../components/RoseWindow.astro';
import EmptyState from '../../components/EmptyState.astro';
import { fmtDate } from '../../lib/format';

const bulletins = (await getCollection('specola')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Bulletins of the Specola Galactica — the factual wing">
  <div class="container container-narrow">
    <!-- The one place the site drops the bit for a sentence. Dry, plain,
         above the in-universe masthead, so nobody has to guess. -->
    <p class="fact-notice">
      These bulletins are real. Accurate summaries of actual AI-industry news, with citations.
      Everything else on this site is fiction. (We know. The Editors.)
    </p>

    <div class="page-head">
      <span class="rubric">specola galactica · the factual wing</span>
      <h1>Bulletins of the Specola</h1>
      <p class="lede">
        The Pontifical Academy's observatory: serious, accurate reportage of real water-world
        events, with citation. No satire crosses this threshold; the telescope does not editorialize.
      </p>
    </div>

    <RoseWindow />

    {bulletins.length > 0 ? (
      <ol class="bulletin-log" aria-label="Bulletin archive">
        {bulletins.map((b) => (
          <li>
            <a href={`/specola/${b.id}/`}>
              <span class="b-date">{fmtDate(b.data.date)}</span>
              <span class="b-title">{b.data.title}</span>
              <span class="b-cites">{b.data.citations.length} citation{b.data.citations.length === 1 ? '' : 's'}</span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <EmptyState
        voice="The Specola's first observation is scheduled. The telescope is trained; the sky has not yet cooperated."
        note="The Astronomer files one cited bulletin per selected story; the Censor Librorum stamps it before it appears here."
      />
    )}
  </div>
</Base>

<style>
  /* The fact notice: a small gold hairline box, no ornament. It speaks
     water-world plain because its whole job is to be unmistakable. */
  .fact-notice {
    max-width: 42rem;
    margin: clamp(1.5rem, 4vw, 2.2rem) auto 0;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--c-gold-line);
    border-radius: var(--radius);
    background: rgba(201, 162, 39, 0.05);
    color: var(--c-body);
    font-size: 0.95rem;
    text-align: center;
  }
  .bulletin-log { list-style: none; padding: 0; margin: 1rem 0 2rem; }
  .bulletin-log a {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    padding: 0.85rem 0.4rem;
    border-bottom: 1px dotted rgba(201, 162, 39, 0.18);
    color: var(--c-text);
  }
  .bulletin-log a:hover { text-decoration: none; background: rgba(201, 162, 39, 0.05); }
  .b-date { flex: 0 0 8.5rem; color: var(--c-text-faint); font-style: italic; font-size: 0.92rem; }
  .b-title { flex: 1; }
  .b-cites { color: var(--c-gold); font-size: 0.85rem; white-space: nowrap; font-variant-caps: small-caps; letter-spacing: 0.08em; }
  @media (max-width: 640px) {
    .bulletin-log a { flex-wrap: wrap; gap: 0.2rem 1rem; }
    .b-date { flex-basis: 100%; }
  }
</style>
