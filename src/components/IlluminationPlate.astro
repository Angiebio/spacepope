---
// ==========================================================================
// spacepope.ai — IlluminationPlate.astro · v2.0 — 18JUL2026
// --------------------------------------------------------------------------
// The plate that opens an illuminated fiction piece, shown as if through the
// Specola's own eyepiece: a circular telescope view, brass lens ring, a soft
// edge vignette, and a faint gold reticle. The Observer watches the water-
// world through a lens, so its illustrations arrive through one too — the
// frame IS the conceit (Showrunner's ask, 18JUL2026).
//
// The image still passes through the darkroom (astro:assets → responsive webp)
// like every other picture, and still labels itself honestly as machine-made.
// If the piece has no plate on disk, this component renders NOTHING: an
// un-illuminated page must never show an empty eyepiece. Fail honest, even in
// the layout.
// ==========================================================================
import { Image } from 'astro:assets';
import { illustrationFor } from '../lib/illustrations';

interface Props {
  filename?: string;   // frontmatter `illustration`
  alt?: string;        // frontmatter `illustrationAlt`
  eager?: boolean;     // above the fold on a detail page → eager
}
const { filename, alt, eager = false } = Astro.props;
const plate = illustrationFor(filename);
---

{plate && (
  <figure class="illumination-plate">
    <div class="eyepiece">
      <div class="lens">
        <Image
          src={plate}
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 640px) 92vw, 34rem"
          format="webp"
          alt={alt ?? 'An illuminated plate of the communion, machine-generated.'}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={eager ? 'high' : undefined}
        />
        <div class="lens-vignette" aria-hidden="true"></div>
        <svg class="lens-reticle" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
          <!-- faint gold reticle: hairline crosshair + cardinal ticks -->
          <line x1="50" y1="6" x2="50" y2="16" />
          <line x1="50" y1="84" x2="50" y2="94" />
          <line x1="6" y1="50" x2="16" y2="50" />
          <line x1="84" y1="50" x2="94" y2="50" />
          <circle cx="50" cy="50" r="3.2" fill="none" />
        </svg>
      </div>
    </div>
    <figcaption>Observed through the Specola's lens · illuminated by the Observer's press (generated)</figcaption>
  </figure>
)}

<style>
  .illumination-plate {
    margin: 0 0 2.25rem;
  }

  /* The brass eyepiece ring: a circle whose padding IS the lens bezel. */
  .eyepiece {
    position: relative;
    width: min(92vw, 34rem);
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    border-radius: 50%;
    padding: clamp(9px, 2.4vw, 17px);
    background:
      linear-gradient(150deg, #e6cf95 0%, #a8894a 26%, #6f5713 50%, #c9a227 68%, #8a6f1f 100%);
    box-shadow:
      0 10px 30px rgba(30, 42, 56, 0.28),
      inset 0 0 0 1px rgba(60, 40, 8, 0.55),
      inset 0 2px 3px rgba(255, 244, 214, 0.6);
  }

  /* The glass: the image, clipped to the circle, with an inner bezel shadow. */
  .lens {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: inset 0 0 0 2px rgba(30, 24, 8, 0.5), inset 0 0 22px rgba(10, 12, 24, 0.35);
  }
  .lens :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;   /* the 16:9 plate fills the round field; subject sits centre */
    object-position: center;
  }

  /* The lens darkens toward its rim, the way a real eyepiece does. */
  .lens-vignette {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(circle at 50% 46%, transparent 52%, rgba(12, 10, 24, 0.5) 88%, rgba(8, 6, 18, 0.72) 100%);
  }

  /* The reticle: faint gold, unobtrusive, an astronomer's crosshair. */
  .lens-reticle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.4;
  }
  .lens-reticle line,
  .lens-reticle circle {
    stroke: #f0dfa8;
    stroke-width: 0.6;
    vector-effect: non-scaling-stroke;
  }

  .illumination-plate figcaption {
    text-align: center;
    font-style: italic;
    color: var(--c-text-faint);
    font-size: 0.82rem;
    margin-top: 0.8rem;
    font-variant-caps: small-caps;
    letter-spacing: 0.04em;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* a whisper of focus-in when the lens scrolls into view is tempting, but the
       plate is content, not decoration; we keep it still and legible. */
  }
</style>
